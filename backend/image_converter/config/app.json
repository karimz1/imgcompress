{
  "temporary_storage": {
    "directory": "/tmp",
    "max_age_seconds": 172800
  },
  "uploads": {
    "max_file_size_mebibytes": 40960
  },
  "web": {
    "host": "0.0.0.0",
    "port": 5000,
    "workers": "auto"
  },
  "logging": {
    "backend_log_file": "/tmp/imgcompress-backend.log",
    "max_size_mebibytes": 25,
    "backup_count": 1
  },
  "crop_preview": {
    "max_retry_attempts": 3,
    "unsupported_input_extensions": [
      ".pdf"
    ]
  },
  "formats": {
    "custom_pipeline_extensions": [
      ".pdf",
      ".psd",
      ".svg",
      ".3fr",
      ".arw",
      ".cr2",
      ".cr3",
      ".dng",
      ".erf",
      ".kdc",
      ".mrw",
      ".nef",
      ".nrw",
      ".orf",
      ".pef",
      ".raf",
      ".rw2",
      ".sr2",
      ".srf",
      ".srw"
    ]
  },
  "features": {
    "is_storage_management_enabled": true,
    "is_logo_enabled": true,
    "is_dev_mode_enabled": false,
    "is_update_check_enabled": true
  },
  "rembg": {
    "model_name": "u2net"
  },
  "upscaling": {
    "threads": "auto",
    "max_output_megapixels": 144
  },
  "public_api": {
    "is_enabled": false
  }
}
