# Copy to .env next to these compose files and edit what you need.
# Domains (imgcompress.lan, ntfy.lan, traefik.lan) are set in the YAML Host
# rules and in PUBLIC_BASE_URL / NTFY_BASE_URL — change those if you rename them.

IMGCOMPRESS_IMAGE=karimz1/imgcompress
IMGCOMPRESS_TAG=latest
IMGCOMPRESS_DISABLE_LOGO=false
IMGCOMPRESS_DISABLE_STORAGE_MANAGEMENT=false
TZ=Europe/Berlin

# Long random topic. On a LAN-only ntfy this is enough (no password).
# Change it before you go live, and use the same value in the ntfy app.
NTFY_TOPIC=imgcompress-7185477bfe6ab346f6c51b08
