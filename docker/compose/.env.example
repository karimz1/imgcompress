# Copy this file to `.env` (in this folder) to begin: cp .env.example .env
# These ENV variables are used by the compose variants in this folder
# Adjust them based on your needs.
IMGCOMPRESS_IMAGE=karimz1/imgcompress
IMGCOMPRESS_TAG=latest
# Bind address: 0.0.0.0 (default) is reachable from your network,
# set 127.0.0.1 to restrict access to this machine only.
# IMGCOMPRESS_HOST=0.0.0.0
IMGCOMPRESS_PORT=3001
IMGCOMPRESS_DISABLE_LOGO=false
# Storage management lets users browse/manage ALL uploaded files.
# Leave this unset to use each compose file's default:
# enabled in the local variants, disabled in the proxied when other users can access it.
# IMGCOMPRESS_DISABLE_STORAGE_MANAGEMENT=false

# --- Required for proxied.docker-compose.yaml (Traefik + HTTPS) ---
# Your domain (DNS A/AAAA record must point to this server):
TRAEFIK_DOMAIN_NAME=imgcompress.example.com
# Contact email required by Let's Encrypt:
ACME_EMAIL=you@example.com
# Credentials for the Traefik dashboard.
# Generate your own hash with: htpasswd -nB admin
# Never copy a hash from an example or tutorial: whoever generated it
# knows the password it belongs to.
TRAEFIK_AUTH_USERS=PASTE_OUTPUT_OF_HTPASSWD_HERE

