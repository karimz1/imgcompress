# General exclusions
.devcontainer/
*.pyc
__pycache__/
.git/
.github/
.pytest_cache/
# Staged registry credentials from scripts/simulateCiTests.sh
.docker-share/
.DS_Store
*.log
*.txt
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/

# These folders will be picked up by copy all /frontend,
# need to exclude them
frontend/e2e-test-results
frontend/node_modules

# Explicitly include requirements files (override *.txt above)
!requirements.txt
!requirements-dev.txt
# Font licences must ship with the bundled fonts (SIL OFL 1.1)
!backend/image_converter/assets/fonts/*/OFL.txt
!frontend/public/fonts/*/OFL.txt

# Exclude other unnecessary files
README.md
LICENSE